[Unit]
Description=kap-mcp (Django site + MCP endpoint)
After=network.target

[Service]
User=cagrigungor-kapmcp
Group=cagrigungor-kapmcp
WorkingDirectory=/home/cagrigungor-kapmcp/htdocs/kapmcp.cagrigungor.com/app/web
EnvironmentFile=/home/cagrigungor-kapmcp/htdocs/kapmcp.cagrigungor.com/.env
ExecStart=/home/cagrigungor-kapmcp/htdocs/kapmcp.cagrigungor.com/venv/bin/uvicorn kapweb.asgi:application --host 127.0.0.1 --port 8194 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
